# .env.example
# Role: Documented environment variables. Copy to `.env` and fill in locally; never commit real secrets.
#
#   cp .env.example .env
#
# Read these only through backend/core/config.py — never call os.environ inline.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=docquery-ai-document-search
ENVIRONMENT=local                       # local | dev | staging | prod
# Serve /docs and /openapi.json. Unset follows ENVIRONMENT (on for `local`, off otherwise),
# so leave it alone locally. Set it explicitly to get Swagger on a deployed instance without
# moving ENVIRONMENT — that one also derives the session cookies' `Secure` flag.
# ENABLE_API_DOCS=true
DEBUG=true
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database — PostgreSQL (local or Docker; RDS is deployment-only)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docquery
POSTGRES_USER=docquery
# POSTGRES_PASSWORD: documentation only — see the note below
POSTGRES_PASSWORD=
# **Only DATABASE_URL is read.** The five POSTGRES_* lines above are documentation: nothing
# in the codebase reads them — `Settings` is configured `extra="ignore"`, and alembic takes
# `DATABASE_URL` and string-replaces the driver (`config.py::sync_database_url`). Changing
# POSTGRES_PORT without changing the port *inside* DATABASE_URL therefore does nothing at
# all, silently. Keep them in step for your own sanity, and treat this line as the authority.
DATABASE_URL=postgresql+asyncpg://docquery:CHANGEME@localhost:5432/docquery
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis / Celery — async document processing, embeddings, analytics rollups
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set true to run ingestion without a broker. See INGEST_LOCAL_CONCURRENCY below for *how* it
# then runs — the two settings decide it together.
CELERY_TASK_ALWAYS_EAGER=false
# How many documents may be ingested at once when CELERY_TASK_ALWAYS_EAGER=true. Above zero,
# each upload is handed to an in-process pool after the request commits: own session, own
# transaction, several documents at a time, and the upload responds as soon as the bytes are
# stored. Zero restores the old inline behaviour — pipeline inside the upload request, one at a
# time, response withheld until the document is indexed.
#
# Ignored entirely when CELERY_TASK_ALWAYS_EAGER=false: a real worker is doing the work then.
# Keep it well under DB_POOL_SIZE — each slot is a connection plus concurrent Bedrock calls.
INGEST_LOCAL_CONCURRENCY=4
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/3   # memory:// if Redis is absent

# ---------------------------------------------------------------------------
# Auth / JWT / RBAC
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY: required — never reuse across environments
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300         # 5h; also the browser session — see config.py
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=10/minute               # slowapi limit applied to /auth/* (per IP)
MAX_FAILED_LOGIN_ATTEMPTS=5             # per account; rate limiting alone is per IP
ACCOUNT_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Session cookies — coupled to the CSRF decision
# ---------------------------------------------------------------------------
# `Secure` is NOT configurable: it is derived as ENVIRONMENT != "local", because a Secure
# cookie is silently dropped by a browser over plain http:// and the only honest way to tie
# the two together is to compute one from the other.
#
# SameSite and the CSRF token are two halves of one control. `secure-coding-vapt.md` requires
# anti-CSRF tokens *because* the JWT lives in an httpOnly cookie the browser attaches by
# itself; SameSite=strict is the backstop for the cases a token misses. Weakening this to
# `lax` or `none` without revisiting that rule reopens exactly what it closes.
COOKIE_SAMESITE=strict
# Left blank so the cookie is host-only — the safest default. Set it only when the API and
# UI share a registrable domain; a broader value hands the session to every subdomain.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# AWS credentials
# ---------------------------------------------------------------------------
# Preferred: leave these blank and use an AWS profile / SSO so no secret lands
# on disk in the repo:   aws configure --profile docquery
# AWS_PROFILE=docquery
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN: only for temporary (ASIA...) credentials
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# AWS Bedrock — RAG pipeline
# ---------------------------------------------------------------------------
BEDROCK_REGION=us-east-1
# Answer generation. Cross-region inference profile IDs carry a "us." prefix.
BEDROCK_LLM_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_LLM_MAX_TOKENS=2048
BEDROCK_LLM_TEMPERATURE=0.0             # 0 = most faithful to retrieved chunks
# Embeddings. Titan Text Embeddings V2 supports 256 / 512 / 1024 dimensions.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true
BEDROCK_MAX_RETRIES=3
BEDROCK_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Pinecone — the vector store
# ---------------------------------------------------------------------------
# Every embedding lives in Pinecone serverless; PostgreSQL stores no vectors,
# so a stock PostgreSQL 17 (no compiled extension) satisfies this project.
# PINECONE_API_KEY: required — starts with "pcsk_"
PINECONE_API_KEY=
PINECONE_INDEX_NAME=docquery-chunks     # lowercase, letters/digits/hyphens, <= 45 chars
PINECONE_CLOUD=aws                      # aws | gcp | azure
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine                  # matches normalized Titan; fixed at index creation
PINECONE_NAMESPACE_PREFIX=tenant-       # one namespace per tenant — the isolation boundary
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_TIMEOUT_SECONDS=20
PINECONE_OVERFETCH_FACTOR=3             # matches are re-checked against document.status

# ---------------------------------------------------------------------------
# AWS S3 — document storage
# ---------------------------------------------------------------------------
# S3_BUCKET_NAME: required
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_DOCUMENT_PREFIX=documents/
S3_SERVER_SIDE_ENCRYPTION=AES256        # AES-256 at rest
S3_VERSIONING_ENABLED=true              # document lineage
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
# Set only when pointing at MinIO / LocalStack instead of real S3.
S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Document ingestion
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx      # allowlist — never accept arbitrary types
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# Retire an earlier version of a name when a re-upload of THE SAME BYTES becomes searchable.
#
# Re-uploading report.pdf always writes a new row at the next version — that is BR-01 lineage
# and does not change. This decides whether the version it replaces stays *in the index*.
#
# The name picks the candidates; the content hash decides. Only a byte-identical earlier version
# is retired, because that is the one case with no judgement in it. A version sharing the name
# but holding different content is LEFT SEARCHABLE and reported in the uploader instead: two
# unrelated documents can both be called invoice.pdf, and nothing distinguishes a corrected
# revision from a different document that reused the name. Removing a live document from search
# on that guess is worse than a duplicate — the duplicate shows up in the answer, the absence
# does not. Use Delete on the older version if it really was replaced; it is reversible.
#
# Nothing is erased — the S3 object, the chunk text and the audit history all stay, Versions
# still lists it, and Restore re-ingests it.
DOCUMENT_SUPERSEDE_PREVIOUS_VERSIONS=true

# ---------------------------------------------------------------------------
# OCR — AWS Textract
# ---------------------------------------------------------------------------
# A PDF with no text layer is a photograph of a document: the parser extracts nothing and the
# document lands `NEEDS_OCR`, excluded from search. With this on, those pages are read by
# Textract and the document becomes searchable like any other, citing the page the words are
# actually on. Per page, so a file with some typed and some scanned pages no longer indexes
# only half of itself.
#
# Needs `textract:StartDocumentTextDetection` + `textract:GetDocumentTextDetection` and
# Textract read access to S3_BUCKET_NAME. Without them the document simply stays `NEEDS_OCR`,
# exactly as before — so leaving this on with no permission is safe, just useless.
OCR_ENABLED=true
# OCR_REGION: blank = AWS_REGION. Textract is not in every region.
OCR_REGION=
# Run OCR during the upload request? This setting only bites in *inline* mode
# (CELERY_TASK_ALWAYS_EAGER=true with INGEST_LOCAL_CONCURRENCY=0), where ingestion shares the
# request's transaction — and that transaction holds pg_advisory_xact_lock('audit_chain:
# <tenant>') from the moment the "upload accepted" audit row is written until commit, so an OCR
# wait queues every other audited operation for the tenant behind it: logins, queries, previews,
# denials.
#
# With INGEST_LOCAL_CONCURRENCY above zero, or with a real Celery worker, the pipeline runs in
# its own transaction and that blast radius does not exist — OCR on upload is then simply the
# behaviour you want, and this stays true.
OCR_ON_UPLOAD=true
# 25s, not 120. The figure was chosen for inline mode, where it bounds how long one upload can
# hold the audit-chain lock; a 1-3 page scan finishes well inside it, and a longer one times out,
# stays NEEDS_OCR and is picked up by scripts/reocr_documents.py.
#
# Running the in-process pool (INGEST_LOCAL_CONCURRENCY>0) makes it safe to raise this — the
# wait is in the background and holds no lock — so a deployment that regularly takes long scans
# can afford 120 here. Left at 25 because it is the conservative value and nothing breaks at it.
OCR_TIMEOUT_SECONDS=25
OCR_POLL_SECONDS=2.0
OCR_MAX_PAGES=200                       # refuse longer scans: billed per page, and it blocks

# ---------------------------------------------------------------------------
# RAG retrieval / grounding
# ---------------------------------------------------------------------------
# Passages offered to the model per question. 10, not 5, because this is a budget for the whole
# corpus rather than per document: five slots were competed for by every document a tenant has,
# so a question answered by one multi-step SOP got two or three chunks of it and the rest from
# elsewhere — and the model, correctly refusing to state what it was not given, wrote a summary.
# At CHUNK_SIZE_TOKENS=512 a five-page SOP is five to ten chunks, so covering one needs roughly
# this many slots.
#
# It loosens no grounding gate: RAG_MIN_SIMILARITY still filters, an uncited claim is discarded,
# and RAG_REQUIRE_SOURCE_CITATION drops an answer that cites nothing. A retrieved-but-irrelevant
# passage is simply never cited.
#
# It does cost: input tokens roughly double (~5k of context) and latency rises. Chosen against a
# 20s QUERY_TIMEOUT_SECONDS that a measured p95 of 8.8s sits well inside — check /analytics
# before raising it further.
RAG_TOP_K=10
# Cosine floor for a retrieved passage. 0.20 is measured, not guessed: against real Titan v2
# embeddings, off-topic questions score 0.09-0.12 while topical ones score 0.28-0.75, so 0.35
# was discarding evidence the corpus plainly contained ("water systems" scored 0.282 against a
# water-systems lease and the user was told it was not there). Re-measure per corpus.
RAG_MIN_SIMILARITY=0.20                 # below this, answer "not found in documents"
RAG_REQUIRE_SOURCE_CITATION=true        # never return an answer without a source
QUERY_TIMEOUT_SECONDS=20                # generation budget; a structured answer needs it

# ---------------------------------------------------------------------------
# Retention / compliance
# ---------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=2555           # 7 years, banking policy
SEARCH_HISTORY_RETENTION_DAYS=365
DELETED_DOCUMENT_PURGE_AFTER_DAYS=30    # soft-delete restoration window

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
