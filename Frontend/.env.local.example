# frontend/.env.local.example
# Role: Documented Next.js environment variables. Copy to `.env.local` and fill in locally.
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Never put a secret, an AWS key, or a signing key behind a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=DocQuery
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_ALLOWED_UPLOAD_EXTENSIONS=pdf,docx
NEXT_PUBLIC_QUERY_TIMEOUT_SECONDS=5

# The email domain the sign-up and sign-in forms tell visitors to use. Display only — the API
# resolves a new user's tenant from their email domain and is the authority on which domains are
# open. Set this to the domain the tenant was seeded with (`scripts/seed_admin.py --email`).
NEXT_PUBLIC_SIGNUP_EMAIL_DOMAIN=docquery.example.com
